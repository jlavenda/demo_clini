/*
  # Seguridad — Edént Soacha / Libeldata
  # Estas cabeceras se aplican a todas las páginas del sitio

  # Evita que el sitio sea embebido en iframes (clickjacking)
  X-Frame-Options: DENY

  # Bloquea inyección de scripts maliciosos (XSS)
  X-XSS-Protection: 1; mode=block

  # Evita que el navegador adivine el tipo de archivo (MIME sniffing)
  X-Content-Type-Options: nosniff

  # Controla información enviada al salir del sitio
  Referrer-Policy: strict-origin-when-cross-origin

  # Bloquea acceso a cámara, micrófono y geolocalización
  Permissions-Policy: camera=(), microphone=(), geolocation=()

  # Fuerza HTTPS — nunca carga en HTTP (1 año)
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

  # Política de contenido — solo carga recursos de fuentes autorizadas
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com https://cdnjs.cloudflare.com https://fonts.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: https://maps.googleapis.com https://maps.gstatic.com https://*.googleapis.com; frame-src https://www.google.com; connect-src 'self' https://formspree.io https://web3forms.com;
